generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CompanyStatus {
  active
  suspended
  trial
  cancelled
}

enum AgencyStatus {
  active
  inactive
  suspended
}

enum UserStatus {
  active
  suspended
  deactivated
}

enum MembershipStatus {
  active
  suspended
  revoked
}

enum RoleScope {
  company
  agency
}

enum InvitationStatus {
  pending
  accepted
  expired
  revoked
}

enum VehicleStatus {
  available
  rented
  maintenance
  inactive
  retired
}

enum FuelType {
  petrol
  diesel
  electric
  hybrid
  lpg
}

enum Transmission {
  manual
  automatic
}

enum InsuranceCoverageType {
  third_party
  comprehensive
  fleet
}

enum InspectionResult {
  pass
  fail
  conditional
}

enum MileageSource {
  contract_pickup
  contract_return
  maintenance
  manual
}

enum AvailabilityBlockReason {
  maintenance
  personal_use
  hold
  other
}

enum VehicleMaintenanceStatus {
  scheduled
  in_progress
  completed
  cancelled
}

enum CustomerType {
  individual
  company
}

enum CustomerStatus {
  active
  inactive
  blacklisted
}

enum CustomerDocumentType {
  passport
  national_id
  driving_license
  residence_permit
}

enum BlacklistSeverity {
  warning
  blocked
  permanent
}

enum ContactType {
  phone
  email
  whatsapp
}

enum ReservationStatus {
  enquiry
  confirmed
  active
  completed
  cancelled
  no_show
}

enum ContractStatus {
  draft
  active
  completed
  cancelled
  disputed
}

enum InspectionEvent {
  pickup
  return
}

enum InspectionCondition {
  ok
  scratched
  dented
  broken
  missing
}

enum SignerType {
  customer
  agent
  witness
}

enum SignatureEvent {
  pickup
  return
}

enum InvoiceStatus {
  draft
  issued
  paid
  partially_paid
  overdue
  voided
}

enum PaymentMethod {
  cash
  bank_transfer
  cheque
  card
  other
}

enum DepositStatus {
  held
  released
  forfeited
  partially_released
}

enum DepositMethod {
  cash
  cheque
  card
  other
}

enum DriverStatus {
  active
  inactive
  suspended
}

enum DriverPricingType {
  monthly
  hourly
  mission
}

enum DriverDocumentType {
  driving_license
  national_id
  contract
  other
}

enum DriverRole {
  primary
  additional
}

// =====================================================================
// Domain 1 — Multi-Tenant
// =====================================================================

model Company {
  id          String        @id @db.Uuid
  name        String
  slug        String        @unique
  countryCode String        @map("country_code") @db.Char(2)
  timezone    String
  currency    String        @db.Char(3)
  language    String        @default("fr")
  planId      String        @map("plan_id") @db.Uuid
  status      CompanyStatus
  trialEndsAt DateTime?     @map("trial_ends_at") @db.Timestamptz()
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz()
  deletedBy   String?       @map("deleted_by") @db.Uuid

  plan                         Plan                          @relation(fields: [planId], references: [id], onDelete: Restrict)
  agencies                     Agency[]
  users                        User[]
  roles                        Role[]
  companyMemberships           CompanyMembership[]
  agencyMemberships            AgencyMembership[]
  invitations                  Invitation[]
  vehicleCategories            VehicleCategory[]
  vehicles                     Vehicle[]
  vehicleInsurances            VehicleInsurance[]
  vehicleInspections           VehicleInspection[]
  vehicleMileageLogs           VehicleMileageLog[]
  vehicleMaintenances          VehicleMaintenance[]
  vehicleRegistrations         VehicleRegistration[]
  vehicleVignettes             VehicleVignette[]
  vehicleAvailabilityBlocks    VehicleAvailabilityBlock[]
  customers                    Customer[]
  customerIndividuals          CustomerIndividual[]
  customerBusinesses           CustomerBusiness[]
  customerContacts             CustomerContact[]
  customerDocuments            CustomerDocument[]
  customerBlacklists           CustomerBlacklist[]
  reservations                 Reservation[]
  reservationPricingSnapshots  ReservationPricingSnapshot[]
  reservationExtras            ReservationExtra[]
  reservationTimelineEvents    ReservationTimelineEvent[]
  contractTemplates            ContractTemplate[]
  contractTemplateVersions     ContractTemplateVersion[]
  contracts                    Contract[]
  contractInspectionItems      ContractInspectionItem[]
  contractSignatures           ContractSignature[]
  expenseCategories            ExpenseCategory[]
  invoices                     Invoice[]
  invoiceLineItems             InvoiceLineItem[]
  payments                     Payment[]
  deposits                     Deposit[]
  creditNotes                  CreditNote[]
  expenses                     Expense[]
  driverPayments               DriverPayment[]
  drivers                      Driver[]
  driverPricingRules           DriverPricingRule[]
  driverDocuments              DriverDocument[]
  driverReservationAssignments DriverReservationAssignment[]
  numberSequences              NumberSequence[]
  settings                     Setting[]
  documents                    Document[]
  auditLogs                    AuditLog[]
  activityLogs                 ActivityLog[]

  @@index([planId])
  @@index([createdAt])
  @@map("companies")
}

model Agency {
  id          String       @id @db.Uuid
  companyId   String       @map("company_id") @db.Uuid
  name        String
  code        String
  countryCode String?      @map("country_code") @db.Char(2)
  timezone    String?
  currency    String?      @db.Char(3)
  phone       String?
  email       String?
  address     Json?        @db.JsonB
  status      AgencyStatus
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?    @map("deleted_at") @db.Timestamptz()
  deletedBy   String?      @map("deleted_by") @db.Uuid

  company                   Company                    @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agencyMemberships         AgencyMembership[]
  invitations               Invitation[]
  vehicles                  Vehicle[]
  vehicleInsurances         VehicleInsurance[]
  vehicleInspections        VehicleInspection[]
  vehicleMaintenances       VehicleMaintenance[]
  vehicleAvailabilityBlocks VehicleAvailabilityBlock[]
  vehicleRegistrations      VehicleRegistration[]
  vehicleVignettes          VehicleVignette[]
  customers                 Customer[]
  reservations              Reservation[]
  contractTemplates         ContractTemplate[]
  contracts                 Contract[]
  invoices                  Invoice[]
  payments                  Payment[]
  deposits                  Deposit[]
  creditNotes               CreditNote[]
  expenses                  Expense[]
  driverPayments            DriverPayment[]
  drivers                   Driver[]
  numberSequences           NumberSequence[]
  settings                  Setting[]
  documents                 Document[]
  auditLogs                 AuditLog[]
  activityLogs              ActivityLog[]

  @@unique([companyId, code])
  @@index([companyId])
  @@index([createdAt])
  @@map("agencies")
}

// =====================================================================
// Domain 2 — Identity
// =====================================================================

model User {
  id              String     @id @db.Uuid
  companyId       String     @map("company_id") @db.Uuid
  email           String     @unique
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz()
  fullName        String     @map("full_name")
  phone           String?
  avatarUrl       String?    @map("avatar_url")
  locale          String?    @default("fr")
  timezone        String?
  status          UserStatus
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz()
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz()
  deletedBy       String?    @map("deleted_by") @db.Uuid

  company                           Company                      @relation(fields: [companyId], references: [id], onDelete: NoAction)
  companyMemberships                CompanyMembership[]
  agencyMemberships                 AgencyMembership[]
  invitationsSent                   Invitation[]                 @relation("InvitationInvitedBy")
  userPermissionOverrides           UserPermissionOverride[]
  vehicleMileageLogs                VehicleMileageLog[]
  vehicleMaintenances               VehicleMaintenance[]
  vehicleAvailabilityBlocks         VehicleAvailabilityBlock[]
  customerBlacklistsAdded           CustomerBlacklist[]          @relation("BlacklistAddedBy")
  customerBlacklistsLifted          CustomerBlacklist[]          @relation("BlacklistLiftedBy")
  reservationsAssigned              Reservation[]                @relation("ReservationAssignedAgent")
  reservationsCancelled             Reservation[]                @relation("ReservationCancelledBy")
  reservationPricingSnapshotsLocked ReservationPricingSnapshot[] @relation("PricingSnapshotLockedBy")
  reservationTimelineEvents         ReservationTimelineEvent[]   @relation("TimelineEventPerformedBy")
  contractTemplateVersionsCreated   ContractTemplateVersion[]
  contractSignatures                ContractSignature[]
  paymentsRecorded                  Payment[]
  depositsCollected                 Deposit[]                    @relation("DepositCollectedBy")
  depositsReleased                  Deposit[]                    @relation("DepositReleasedBy")
  creditNotesIssued                 CreditNote[]
  expensesRecorded                  Expense[]
  driverPaymentsRecorded            DriverPayment[]
  documentsUploaded                 Document[]
  auditLogs                         AuditLog[]
  activityLogs                      ActivityLog[]

  @@index([companyId])
  @@index([phone])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String    @id @db.Uuid
  companyId   String    @map("company_id") @db.Uuid
  name        String
  description String?
  scope       RoleScope
  isSystem    Boolean   @default(false) @map("is_system")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy   String?   @map("deleted_by") @db.Uuid

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: NoAction)
  rolePermissions         RolePermission[]
  companyMemberships      CompanyMembership[]
  agencyMemberships       AgencyMembership[]
  userPermissionOverrides UserPermissionOverride[]
  invitations             Invitation[]

  @@unique([id, scope])
  @@unique([companyId, name, scope])
  @@index([companyId])
  @@index([createdAt])
  @@map("roles")
}

model Permission {
  id          String   @id @db.Uuid
  key         String   @unique
  domain      String
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  rolePermissions         RolePermission[]
  userPermissionOverrides UserPermissionOverride[]

  @@map("permissions")
}

model RolePermission {
  id            String   @id @db.Uuid
  roleId        String   @map("role_id") @db.Uuid
  permissionKey String   @map("permission_key")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz()

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionKey], references: [key], onDelete: NoAction)

  @@unique([roleId, permissionKey])
  @@map("role_permissions")
}

model CompanyMembership {
  id        String           @id @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  roleScope RoleScope        @default(company) @map("role_scope")
  status    MembershipStatus
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz()
  deletedBy String?          @map("deleted_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  user    User    @relation(fields: [userId], references: [id], onDelete: NoAction)
  role    Role    @relation(fields: [roleId, roleScope], references: [id, scope], onDelete: NoAction)

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([roleId, roleScope])
  @@index([createdAt])
  @@map("company_memberships")
}

model AgencyMembership {
  id        String           @id @db.Uuid
  companyId String           @map("company_id") @db.Uuid
  agencyId  String           @map("agency_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  roleId    String           @map("role_id") @db.Uuid
  roleScope RoleScope        @default(agency) @map("role_scope")
  isPrimary Boolean          @default(false) @map("is_primary")
  status    MembershipStatus
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz()
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime?        @map("deleted_at") @db.Timestamptz()
  deletedBy String?          @map("deleted_by") @db.Uuid

  company                 Company                  @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agency                  Agency                   @relation(fields: [agencyId], references: [id], onDelete: NoAction)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: NoAction)
  role                    Role                     @relation(fields: [roleId, roleScope], references: [id, scope], onDelete: NoAction)
  userPermissionOverrides UserPermissionOverride[]

  @@unique([userId, agencyId])
  @@index([companyId])
  @@index([agencyId])
  @@index([roleId, roleScope])
  @@index([isPrimary])
  @@index([createdAt])
  @@map("agency_memberships")
}

model UserPermissionOverride {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  agencyMembershipId String    @map("agency_membership_id") @db.Uuid
  permissionKey      String    @map("permission_key")
  roleId             String    @map("role_id") @db.Uuid
  reason             String
  expiresAt          DateTime? @map("expires_at") @db.Timestamptz()
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz()

  user             User             @relation(fields: [userId], references: [id], onDelete: NoAction)
  agencyMembership AgencyMembership @relation(fields: [agencyMembershipId], references: [id], onDelete: NoAction)
  permission       Permission       @relation(fields: [permissionKey], references: [key], onDelete: NoAction)
  role             Role             @relation(fields: [roleId], references: [id], onDelete: NoAction)

  @@index([userId])
  @@index([agencyMembershipId])
  @@index([createdAt])
  @@map("user_permission_overrides")
}

model Invitation {
  id         String           @id @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  agencyId   String?          @map("agency_id") @db.Uuid
  email      String
  roleId     String           @map("role_id") @db.Uuid
  invitedBy  String           @map("invited_by") @db.Uuid
  tokenHash  String           @unique @map("token_hash")
  status     InvitationStatus
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz()
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz()
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt  DateTime         @updatedAt @map("updated_at") @db.Timestamptz()

  company       Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agency        Agency? @relation(fields: [agencyId], references: [id], onDelete: NoAction)
  role          Role    @relation(fields: [roleId], references: [id], onDelete: NoAction)
  invitedByUser User    @relation("InvitationInvitedBy", fields: [invitedBy], references: [id], onDelete: NoAction)

  @@unique([companyId, email])
  @@index([companyId])
  @@index([agencyId])
  @@index([email])
  @@index([expiresAt])
  @@index([createdAt])
  @@map("invitations")
}

// =====================================================================
// Domain 4 — Fleet
// =====================================================================

model VehicleCategory {
  id        String    @id @db.Uuid
  companyId String    @map("company_id") @db.Uuid
  name      String
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz()
  deletedBy String?   @map("deleted_by") @db.Uuid

  company  Company   @relation(fields: [companyId], references: [id], onDelete: NoAction)
  vehicles Vehicle[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([createdAt])
  @@map("vehicle_categories")
}

model Vehicle {
  id           String        @id @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  agencyId     String        @map("agency_id") @db.Uuid
  categoryId   String        @map("category_id") @db.Uuid
  code         String
  plate        String
  vin          String?
  brand        String
  model        String
  year         Int           @db.SmallInt
  color        String?
  fuelType     FuelType      @map("fuel_type")
  transmission Transmission
  seats        Int?          @db.SmallInt
  status       VehicleStatus
  notes        String?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt    DateTime      @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt    DateTime?     @map("deleted_at") @db.Timestamptz()
  deletedBy    String?       @map("deleted_by") @db.Uuid

  // NOTE: `category_id` replaces the legacy `category text` column per PRISMA_IMPLEMENTATION_PLAN.md (FK precedence).

  company  Company         @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agency   Agency          @relation(fields: [agencyId], references: [id], onDelete: NoAction)
  category VehicleCategory @relation(fields: [categoryId], references: [id], onDelete: NoAction)

  vehicleInsurances         VehicleInsurance[]
  vehicleInspections        VehicleInspection[]
  vehicleMileageLogs        VehicleMileageLog[]
  vehicleMaintenances       VehicleMaintenance[]
  vehicleAvailabilityBlocks VehicleAvailabilityBlock[]
  reservations              Reservation[]
  contracts                 Contract[]
  expenses                  Expense[]
  vehicleRegistrations      VehicleRegistration[]
  vehicleVignettes          VehicleVignette[]

  @@unique([companyId, plate])
  @@unique([companyId, code])
  @@index([companyId])
  @@index([agencyId])
  @@index([createdAt])
  @@index([status])
  @@index([categoryId])
  @@map("vehicles")
}

model VehicleInsurance {
  id            String                 @id @db.Uuid
  companyId     String                 @map("company_id") @db.Uuid
  agencyId      String                 @map("agency_id") @db.Uuid
  vehicleId     String                 @map("vehicle_id") @db.Uuid
  provider      String
  policyNumber  String                 @map("policy_number")
  coverageType  InsuranceCoverageType? @map("coverage_type")
  startsAt      DateTime               @map("starts_at") @db.Date
  expiresAt     DateTime               @map("expires_at") @db.Date
  premiumAmount Decimal?               @map("premium_amount") @db.Decimal(14, 4)
  currency      String?                @db.Char(3)
  documentUrl   String?                @map("document_url")
  createdAt     DateTime               @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt     DateTime               @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt     DateTime?              @map("deleted_at") @db.Timestamptz()
  deletedBy     String?                @map("deleted_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: NoAction)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: NoAction)

  @@index([companyId])
  @@index([agencyId])
  @@index([createdAt])
  @@index([vehicleId, expiresAt])
  @@map("vehicle_insurances")
}

model VehicleRegistration {
  id                 String    @id @db.Uuid
  companyId          String    @map("company_id") @db.Uuid
  agencyId           String    @map("agency_id") @db.Uuid
  vehicleId          String    @map("vehicle_id") @db.Uuid
  registrationNumber String    @map("registration_number")
  issuedAt           DateTime? @map("issued_at") @db.Date
  expiresAt          DateTime  @map("expires_at") @db.Date
  issuingAuthority   String?   @map("issuing_authority")
  documentUrl        String?   @map("document_url")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz()

  // Append-only expiry record (created_at only; no updated_at, no soft delete) per DATABASE_PHASE1.md.
  // `expires_at` NOT NULL — the compliance alert fires 30 days before it.

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: NoAction)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: NoAction)

  @@index([companyId])
  @@index([agencyId])
  @@index([createdAt])
  @@index([vehicleId, expiresAt])
  @@map("vehicle_registrations")
}

model VehicleVignette {
  id          String   @id @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  agencyId    String   @map("agency_id") @db.Uuid
  vehicleId   String   @map("vehicle_id") @db.Uuid
  taxYear     Int      @map("tax_year") @db.SmallInt
  paidAt      DateTime @map("paid_at") @db.Date
  expiresAt   DateTime @map("expires_at") @db.Date
  amount      Decimal? @db.Decimal(14, 4)
  currency    String?  @db.Char(3)
  documentUrl String?  @map("document_url")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz()

  // Append-only expiry record (created_at only; no updated_at, no soft delete) per DATABASE_PHASE1.md.
  // `amount` is Decimal(14,4) + currency CHAR(3) per FINAL_DATABASE_SOURCE_OF_TRUTH.md § 4 (supersedes PHASE1 numeric(10,2)).

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: NoAction)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: NoAction)

  @@unique([vehicleId, taxYear])
  @@index([companyId])
  @@index([agencyId])
  @@index([createdAt])
  @@index([vehicleId, expiresAt])
  @@map("vehicle_vignettes")
}

model VehicleInspection {
  id          String           @id @db.Uuid
  companyId   String           @map("company_id") @db.Uuid
  agencyId    String           @map("agency_id") @db.Uuid
  vehicleId   String           @map("vehicle_id") @db.Uuid
  inspectedAt DateTime         @map("inspected_at") @db.Date
  expiresAt   DateTime         @map("expires_at") @db.Date
  result      InspectionResult
  center      String?
  cost        Decimal?         @db.Decimal(14, 4)
  currency    String?          @db.Char(3)
  documentUrl String?          @map("document_url")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz()
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz()
  deletedAt   DateTime?        @map("deleted_at") @db.Timestamptz()
  deletedBy   String?          @map("deleted_by") @db.Uuid

  company Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  agency  Agency  @relation(fields: [agencyId], references: [id], onDelete: NoAction)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: NoAction)

  @@index([companyId])
  @@index([agencyId])
  @@index([createdAt])
  @@index([vehicleId, expiresAt])
  @@map("vehicle_inspections")
}

model VehicleMileageLog {
  id          String        @id @db.Uuid
  companyId   String        @map("company_id") @db.Uuid
  vehicleId   String        @map("vehicle_id") @db.Uuid
  mileage     Int
  recordedAt  DateTime      @map("recorded_at") @db.Timestamptz()
  source      MileageSource
  referenceId String?       @map("reference_id") @db.Uuid
  recordedBy  String?       @map("recorded_by") @db.Uuid
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz()

  // Append-only (no updatedAt, no soft delete) per PRISMA_IMPLEMENTATION_PLAN.md § 7 / § 8.
  // `reference_id` is a polymorphic pointer to the source record — intentionally no FK.

  company        Company @relation(fields: [companyId], references: [id], onDelete: NoAction)
  recordedByUser User?   @relation(fields: [recordedBy], references: [id], onDelete: NoAction)
  vehicle        Vehicle @relation(fields: [vehicleId], references: [id], onDelete: NoAction)

  @@index([companyId])
  @@index([createdAt])
  @@index([vehicleId, recordedAt])
  @@map("vehicle_mileage_logs")
}

