{
  "name": "@lokarent/db",
  "version": "0.0.1",
  "description": "Prisma database client and schema for LokaRent",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "prisma:format": "prisma format --schema prisma/schema.prisma",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "prisma:version": "prisma version",

    "migrate": "prisma migrate dev --schema prisma/schema.prisma",
    "migrate:create": "prisma migrate dev --create-only --schema prisma/schema.prisma",
    "migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "migrate:status": "prisma migrate status --schema prisma/schema.prisma",
    "migrate:reset": "prisma migrate reset --schema prisma/schema.prisma",

    "db:pull": "prisma db pull --schema prisma/schema.prisma",

    "seed": "node --experimental-strip-types src/seed.ts",
    "seed:core": "node --experimental-strip-types src/seed.ts",

    "check": "npm run prisma:format && npm run prisma:validate && npm run prisma:generate"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "tsx": "^4.0.0"
  }
}